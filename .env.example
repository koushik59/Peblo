# =============================================================================
# Peblo TV Mini — Environment Configuration
# Copy this file to .env and fill in appropriate values
# =============================================================================

# Database
DATABASE_URL=postgresql+asyncpg://peblo:peblo_secret@db:5432/peblo_tv
DATABASE_URL_SYNC=postgresql://peblo:peblo_secret@db:5432/peblo_tv

# JWT Authentication
JWT_SECRET=change-me-in-production-use-a-real-32-byte-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=480

# Storage Configuration
# Options: "local" (default for dev/docker) or "r2" / "s3" (for production)
STORAGE_BACKEND=local
STORAGE_PATH=/app/storage_data

# Cloudflare R2 / AWS S3 Credentials (Required if STORAGE_BACKEND=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=peblo-tv
R2_PUBLIC_URL=https://pub-your-id.r2.dev

# Server & Networking
API_HOST=0.0.0.0
API_PORT=8000
API_URL=http://localhost:8000
CMS_URL=http://localhost:3001
VIEWER_URL=http://localhost:3002

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# =============================================================================
# Production Secret Management Strategy
# =============================================================================
# In production, never commit .env files to source control:
# 1. Secret Store: Use AWS Secrets Manager, Google Secret Manager, or HashiCorp Vault.
# 2. Container Injection: Inject secrets as environment variables at container runtime
#    using Kubernetes Secrets / AWS ECS task definition secrets.
# 3. Rotation: Regularly rotate JWT_SECRET and Cloudflare R2 access keys without downtime.
